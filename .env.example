# Weather Agent Environment Configuration
# Copy this file to .env and replace placeholders with your actual keys

# Secret token required to authenticate against /agent/invoke (Bearer token)
AGENT_API_TOKEN=your_secure_agent_token_here

# OpenWeatherMap API key (get one from https://home.openweathermap.org/api_keys)
WEATHER_API_KEY=your_openweather_api_key_here
